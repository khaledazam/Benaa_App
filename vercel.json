{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/benaa-release.apk",
      "headers": {
        "Content-Disposition": "attachment; filename=\"benaa-release.apk\"",
        "Content-Type": "application/vnd.android.package-archive"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
